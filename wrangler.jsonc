// Cloudflare Workers 部署設定（《魔蝕milner》第二章）。第一章是另一個 Worker（kooomp），這裡是第二章自己的 Worker（magical2），兩邊分開。
// 第二章還沒部署過：第一次部署前要先問製作人（網址會是 https://magical2.<帳號>.workers.dev/）
// - 網頁：tools/build.mjs 產生 dist/（程式打包、混淆），只發佈 dist/
// - 遊戲 API 與房間：server/worker.mjs、server/room.mjs（Durable Objects，答案只在這裡，不會出現在網頁）
{
  "name": "magical2",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "npm ci --prefix tools && node tools/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "PROFILES", "class_name": "Profile" }]
  },
  // 存檔（server/profile.mjs）是第 6 批加的，所以是 v2
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Profile"] }],
  "vars": {
    "SUPABASE_URL": "https://umlnwzpmjxktfzjvcbts.supabase.co",
    "SUPABASE_KEY": "sb_publishable_8J3VI8dijlCccHQbXPfCQQ_v_O0Au3w"
  }
}
